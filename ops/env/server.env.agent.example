# Copy to server.env.agent. Agents get this file, never the production .env.
# Use a separate Supabase project, session pooler, port 5432.
PORT=8080
APP_ENV=development
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cvs
PUBLIC_APP_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
BFF_SHARED_SECRET=agent-only-not-a-real-secret
RECRUITER_PASSWORD=agent-only-not-a-real-secret
AUTH_TOKEN_SECRET=agent-only-not-a-real-secret
LLM_MODE=fake
LLM_BASE_URL=https://openrouter.ai/api/v1
MODELS_CONFIG_PATH=./config/models.yaml
EMAIL_MODE=log
SESSION_TTL_HOURS=168
SESSION_MAX_MINUTES=15
SESSION_MAX_QUESTIONS=15
