#!/usr/bin/env python3
"""Move the orchestrator's secrets into the encrypted store (ops/creds.py, ADR 0006).

ops/creds import NAME FILE [--remove]   encrypt FILE as NAME; --remove deletes FILE after the round trip
ops/creds list                          which secrets are stored, and which plain files are left
ops/creds check                         decrypt each stored secret and print only its size

Values are never printed. NAME is one of: claude-oauth-token, agent-gh-token, client-env-agent,
agent-app-key, orchestrator-app-key.
"""
import sys
from pathlib import Path

sys.path.insert(0, __file__.rsplit("/", 1)[0])
import creds


def main(argv):
    if len(argv) >= 4 and argv[1] == "import":
        name, source = argv[2], Path(argv[3])
        target = creds.write(name, source.read_bytes())
        print(f"{name}: encrypted into {target}")
        if "--remove" in argv:
            source.unlink()
            print(f"{name}: removed the plain file {source}")
        return 0
    if argv[1:2] == ["list"]:
        for name, legacy in creds.NAMES.items():
            stored = "stored" if creds.path(name).exists() else "not stored"
            left = f"; plain file still at {legacy}" if legacy and legacy.exists() else ""
            print(f"{name}: {stored}{left}")
        return 0
    if argv[1:2] == ["check"]:
        bad = 0
        for name in creds.NAMES:
            if not creds.path(name).exists():
                continue
            try:
                print(f"{name}: ok ({len(creds.read(name, {'secret_store': 'creds'}))} bytes)")
            except creds.SecretMissing as err:
                bad += 1
                print(f"{name}: FAIL {err}")
        return 1 if bad else 0
    print(__doc__.strip())
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
