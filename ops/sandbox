#!/usr/bin/env python3
"""Sandbox images (ADR 0003). Usage: ops/sandbox build [client|server]   ops/sandbox tags"""
import sys

sys.path.insert(0, __file__.rsplit("/", 1)[0])
import container
from lib import REPOS

args = sys.argv[1:]
if not args or args[0] not in ("build", "tags"):
    sys.exit(__doc__)
repos = args[1:] or list(REPOS)
for repo in repos:
    if args[0] == "build":
        container.build(repo)
    print(container.image_tag(repo))
