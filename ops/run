#!/usr/bin/env python3
"""Orchestrator: next -> worktree -> agent -> gate -> PR -> CI -> review -> merge or escalate.

ops/run [--repo client|server] [--node client#15] [--once] [--auto]
ops/run --reconcile   tidy labels and worktrees after you merge
ops/run --check-agent-auth   prove the agent token reads issues and cannot push
ops/run --check-sandbox   prove the sandbox walls from inside each image
Without --auto every outward step asks first. Run one process per repo for parallel work.
"""
import contextlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, __file__.rsplit("/", 1)[0])
import importlib.machinery
import importlib.util

import container
from checks import feedback, gate, saw_key
from lib import (AGENT_LOGIN_KEEP, AGENTS, HANDOFF_DIR, HANDOFF_MARK, OPS, PROXY_ENV_KEEP, REPOS, ROOT, STATE,
                 STOP_FILE, TOOLCHAIN_ENV_KEEP, analyze, check_env, config, gh, handoff_path, load_nodes,
                 load_state, parse_handoff, save_state, sh, state_path, with_egress)

_loader = importlib.machinery.SourceFileLoader("brief", str(OPS / "brief"))
_spec = importlib.util.spec_from_loader("brief", _loader)
_brief = importlib.util.module_from_spec(_spec)
_loader.exec_module(_brief)

AUTO = "--auto" in sys.argv
LAST_AGENT_ERROR = None  # the API error that ended the last agent run, if any
LAST_EGRESS_REFUSED = []  # hosts the sandbox's proxy refused during the last agent run
REVIEW_UNAVAILABLE = None  # why the last independent review returned no findings
CLAUDE_TOOLS = ["Read", "Edit", "Write", "Glob", "Grep", "Bash(pnpm:*)", "Bash(go:*)", "Bash(gofmt:*)",
                "Bash(git add:*)", "Bash(git commit:*)", "Bash(git status:*)", "Bash(git diff:*)",
                "Bash(git log:*)", "Bash(git show:*)", "Bash(gh issue view:*)", "Bash(gh issue list:*)",
                "Bash(gh issue create:*)", "Bash(gh issue comment:*)", "Bash(rg:*)", "Bash(ls:*)"]

# The agent's own GitHub identity: a fine-grained token with Issues read/write and Metadata read only.
# It cannot push, open PRs or merge; ops/run does those with the human's gh. See WORKFLOW.md.
AGENT_GH_TOKEN = OPS / "env" / "agent.gh-token"
# Agents run code they write (go test, pnpm scripts), so every variable passed here reaches that
# code too. The lists live in lib.py, shared with the gate's checks; agents add only their CLI login.
AGENT_ENV_KEEP = {**TOOLCHAIN_ENV_KEEP, **AGENT_LOGIN_KEEP, **PROXY_ENV_KEEP}
# Set by ops/run itself, never copied from the parent.
AGENT_ENV_SET = {"PWD", "OPENCODE_CONFIG_CONTENT", "GH_TOKEN", "GH_CONFIG_DIR", "GH_PROMPT_DISABLED",
                 "GIT_TERMINAL_PROMPT", "GIT_CONFIG_COUNT"}
# Git config through the environment. The remotes use SSH and the human's key, so github.com goes
# over HTTPS instead, where the only credential is the agent token (gh reads GH_TOKEN). The empty
# helper first clears any helper the human configured.
AGENT_GIT_CONFIG = [("url.https://github.com/.insteadOf", "git@github.com:"),
                    ("url.https://github.com/.insteadOf", "ssh://git@github.com/"),
                    ("credential.helper", ""),
                    ("credential.helper", "!gh auth git-credential")]


class Stop(Exception):
    pass


def agent_env(wt, gh_config_dir):
    """The whole environment an agent gets. gh_config_dir is an empty dir, so gh has no login to fall back to."""
    try:
        token = AGENT_GH_TOKEN.read_text().strip()
    except FileNotFoundError:
        raise Stop(f"no agent GitHub token at {AGENT_GH_TOKEN}; see 'Agent GitHub token' in WORKFLOW.md")
    if not token.startswith("github_pat_"):
        raise Stop(f"{AGENT_GH_TOKEN} must hold a fine-grained token (github_pat_...), not a classic or gh login token")
    env = {k: os.environ[k] for k in AGENT_ENV_KEEP if k in os.environ}
    env.update(PWD=str(wt), GH_TOKEN=token, GH_CONFIG_DIR=str(gh_config_dir), GH_PROMPT_DISABLED="1",
               GIT_TERMINAL_PROMPT="0", GIT_CONFIG_COUNT=str(len(AGENT_GIT_CONFIG)))
    for i, (key, value) in enumerate(AGENT_GIT_CONFIG):
        env[f"GIT_CONFIG_KEY_{i}"], env[f"GIT_CONFIG_VALUE_{i}"] = key, value
    return env


def confirm(step):
    if STOP_FILE.exists():
        raise Stop("stop requested")
    if not AUTO and input(f"{step} [y/N] ").strip().lower() != "y":
        raise Stop(f"declined: {step}")


def go_mod_cache():
    try:
        return sh(["go", "env", "GOMODCACHE"]).stdout.strip() or str(Path.home() / "go/pkg/mod")
    except Exception:
        return str(Path.home() / "go/pkg/mod")


def read_events(lines, seen, log, events):
    """Log OpenCode JSON events readably, keep the reply text, and add up the cost."""
    for line in lines:
        try:
            event = json.loads(line) if events else None
        except ValueError:
            event = None
        if not isinstance(event, dict) or "type" not in event:
            seen["text"].append(line)
            log.write(line + "\n")
            continue
        part = event.get("part", {})
        if event["type"] == "step_finish":
            seen["cost"] += part.get("cost") or 0
        elif event["type"] == "tool_use":
            state = part.get("state", {})
            log.write(f"→ {part.get('tool')} {state.get('title') or ''} [{state.get('status')}]\n")
        elif event["type"] == "text":
            seen["text"].append(part.get("text", ""))
            log.write(part.get("text", "") + "\n")
        elif event["type"] == "error":
            # An API refusal (no balance, region, auth) ends the run; say so instead of failing silently.
            error = event.get("error") or {}
            data = error.get("data") or {}
            status = f" {data['statusCode']}" if data.get("statusCode") else ""
            seen["error"] = f"opencode {error.get('name', 'error')}{status}: {data.get('message') or error}"
            log.write(f"ERROR {seen['error']}\n")
    log.flush()


def run_agent(agent, prompt, wt, cfg, read_only=False):
    global LAST_AGENT_ERROR, LAST_EGRESS_REFUSED
    LAST_AGENT_ERROR, LAST_EGRESS_REFUSED = None, []
    HANDOFF_DIR.mkdir(parents=True, exist_ok=True)
    boxed = container.mode(cfg) == "container"
    repo = Path(wt).name.split("-")[0]
    work = wt  # where the agent works: the human's worktree on the host, its own clone in the sandbox
    if boxed:
        container.require_image(repo)  # fail closed before anything starts
        container.ensure_egress(cfg)
        work = container.ensure_clone(wt)
    if agent == "claude":
        claude = shutil.which("claude") or str(Path.home() / ".local/bin/claude")
        tools = ["Read", "Glob", "Grep"] if read_only else CLAUDE_TOOLS
        dirs = [str(HANDOFF_DIR)] + ([go_mod_cache()] if not boxed or repo == "server" else [])
        cmd = ["claude" if boxed else claude, "-p", "--model", cfg["claude_model"], "--effort", cfg["claude_effort"],
               "--max-budget-usd", str(cfg["budget_usd"]), "--no-session-persistence",
               "--add-dir", *dirs, "--allowedTools", *tools]
        if not read_only:
            cmd += ["--permission-mode", "acceptEdits"]
    else:
        cmd = ["opencode", "run", "--model", cfg["opencode_model"], "--dir", str(work), "--format", "json"]
        if cfg.get("opencode_effort"):  # OpenCode calls reasoning effort a model variant
            cmd += ["--variant", cfg["opencode_effort"]]
        if read_only:
            cmd += ["--agent", "plan"]
    # Outside the worktree, agents may read the Go module cache and write their handoff file.
    # OpenCode takes its project directory from PWD, not from the process cwd.
    # Everything else outside is "deny", not the default "ask": a rejected ask ends the whole OpenCode
    # run without a handoff, while a deny returns an error the agent can read and work around.
    outside = {"*": "deny", f"{go_mod_cache()}/**": "allow", f"{HANDOFF_DIR}/*": "allow"}
    log_path = STATE / f"{Path(wt).name}.log"
    seen, partial = {"cost": 0.0, "text": []}, ""
    with tempfile.TemporaryDirectory() as tmp, open(log_path, "a") as log, contextlib.ExitStack() as stack:
        gh_config = Path(tmp, "gh")
        gh_config.mkdir()
        env = agent_env(work, gh_config)
        env["OPENCODE_CONFIG_CONTENT"] = json.dumps({"permission": {"external_directory": outside}})
        box_name = None
        if boxed:
            if agent == "claude":
                env["CLAUDE_CODE_OAUTH_TOKEN"] = container.claude_token()
            home = stack.enter_context(container.agent_home())
            env_path = stack.enter_context(container.env_file({**container.container_env(env),
                                                               **container.cache_env(repo)}))
            mounts = container.agent_mounts(work, read_only, HANDOFF_DIR, home) + container.cache_mounts(repo)
            box_name = f"ts-{agent}-{Path(wt).name}-{int(time.time())}"
            cmd = container.podman_argv(repo, cfg, work, cmd, env_path, mounts=mounts, read_only=read_only,
                                        name=box_name)
            env = dict(os.environ)  # for podman itself; the agent sees only the env file
        out = Path(tmp, "out")
        # The prompt goes through stdin: one argv string is capped at 128 KiB, and a review prompt
        # carries the whole diff.
        brief = Path(tmp, "prompt")
        brief.write_text(prompt)
        with open(out, "w") as sink, open(out) as source, open(brief) as stdin:
            child = subprocess.Popen(cmd, cwd=wt, env=env, stdin=stdin, stdout=sink, stderr=log, text=True,
                                     start_new_session=True)
            started = time.time()
            deadline = started + cfg["timeout_min"] * 60
            # OpenCode streams JSON events; a run that prints nothing for this long has stalled.
            # Claude -p prints only at the end, so it has no idle limit.
            idle_s = cfg.get("idle_min", 10) * 60 if agent == "opencode" else None
            last_output = started
            while True:
                done = child.poll() is not None
                fresh = source.read()
                if fresh:
                    last_output = time.time()
                chunk = partial + fresh
                lines = chunk.split("\n")
                partial = "" if done else lines.pop()
                if done and lines and not lines[-1]:
                    lines.pop()
                read_events(lines, seen, log, events=agent == "opencode")
                if done:
                    break
                over_budget = agent == "opencode" and seen["cost"] > cfg["budget_usd"]
                idle = idle_s is not None and time.time() - last_output > idle_s
                if STOP_FILE.exists() or time.time() > deadline or over_budget or idle:
                    os.killpg(child.pid, signal.SIGTERM)
                    child.wait(30)
                    if box_name:
                        subprocess.run([container.PODMAN, "rm", "-f", "--ignore", box_name], capture_output=True)
                    raise Stop("stop requested" if STOP_FILE.exists() else
                               f"cost budget spent (${seen['cost']:.2f})" if over_budget else
                               f"no output for {cfg.get('idle_min', 10):g} min" if idle else "time budget spent")
                time.sleep(3)
                elapsed = int(time.time() - started)
                if elapsed >= 60 and elapsed % 60 < 3:
                    cost = f", ${seen['cost']:.2f}" if agent == "opencode" else ""
                    print(f"  {agent} working, {elapsed // 60} min{cost} (tail -f {log_path})", flush=True)
    LAST_AGENT_ERROR = seen.get("error")
    if boxed:
        refused = LAST_EGRESS_REFUSED = container.save_egress_log(Path(wt).name, started)
        if refused:
            print(f"  egress refused for {Path(wt).name}: {', '.join(refused)} (ops/.state/egress/)", flush=True)
        if not read_only:
            # The gate, the push and the review read the human's worktree; the agent's commits come
            # back as a bundle with hooks off. Uncommitted changes in the clone stay there.
            container.import_agent_commits(work, wt, repo, cfg)
    return child.returncode, "\n".join(seen["text"])


def prepare(node):
    wt = ROOT / "wt" / f"{node.repo}-{node.number}"
    checkout = ROOT / f"talent-scout-{node.repo}"
    sh(["git", "fetch", "-q", "origin"], cwd=checkout)
    if not wt.exists():
        slug = re.sub(r"[^a-z0-9]+", "-", node.title.lower())[:30].strip("-")
        sh(["git", "worktree", "add", "-q", str(wt), "-b", f"node/{node.number}-{slug}",
            "--no-track", "origin/main"], cwd=checkout)
        cfg = config()
        if container.mode(cfg) == "container":
            container.ensure_clone(wt)
        if node.repo == "client":
            # The client build reads its local, non-production values from .env. Nothing the server agent
            # runs reads .env (config and the live tests use the process env), so its secrets stay out.
            agent_env = OPS / "env" / "client.env.agent"
            boxed = container.mode(cfg) == "container"
            # The checks run in the worktree; in the sandbox the agent works in its clone. Both need these.
            targets = [wt] + ([container.clone_path(wt)] if boxed else [])
            for target in targets:
                if agent_env.exists():
                    shutil.copy2(agent_env, target / ".env")
            if boxed:
                for target in targets:
                    done = container.run_code("pnpm install --frozen-lockfile", str(target), "client", cfg, timeout=600)
                    if done.returncode:
                        raise RuntimeError(f"pnpm install in the sandbox: {done.stderr.strip()[-500:]}")
            else:
                sh(["pnpm", "install", "--frozen-lockfile"], cwd=wt, timeout=600, env=check_env())
    return wt


def set_status(node, new):
    gh("issue", "edit", str(node.number), "-R", REPOS[node.repo], "--add-label", new,
       *[arg for label in node.labels if label.startswith("status:") and label != new
         for arg in ("--remove-label", label)])
    node.labels = [l for l in node.labels if not l.startswith("status:")] + [new]


def post_handoff(node, text):
    text = with_egress(text, load_state(node.id).get("egress_refused", []))
    gh("issue", "comment", str(node.number), "-R", REPOS[node.repo],
       "--body", f"{HANDOFF_MARK}\n{text.strip()}")


def escalate(node, reason, feedback_text=""):
    post_handoff(node, f"STATUS: needs_human\nNEXT: {reason}\nKNOWN: {feedback_text or 'see the run log'}")
    gh("issue", "edit", str(node.number), "-R", REPOS[node.repo], "--add-label", "needs:human")
    print(f"{node.id}: escalated: {reason}")


def add_gaps(node, gaps):
    """Add gap issues as blockers, so the graph reschedules this node after them."""
    ids = re.findall(r"(?:client|server)#\d+", gaps)
    current = node.block.get("blocked_by", [])
    merged = ", ".join(dict.fromkeys(current + ids))
    body = re.sub(r"^blocked_by:.*$", f"blocked_by: [{merged}]", node.body, flags=re.M)
    gh("issue", "edit", str(node.number), "-R", REPOS[node.repo], "--body", body)
    return ids


def wait_ci(node, branch, cfg):
    full = REPOS[node.repo]
    deadline = time.time() + cfg["ci_wait_min"] * 60
    time.sleep(20)
    while time.time() < deadline:
        if STOP_FILE.exists():
            raise Stop("stop requested")
        raw = sh(["gh", "pr", "checks", branch, "-R", full, "--json", "name,bucket"], check=False).stdout
        checks = json.loads(raw or "[]")
        if checks and all(c["bucket"] != "pending" for c in checks):
            bad = [c["name"] for c in checks if c["bucket"] == "fail"]
            return [{"check": "ci", "expected": "all PR checks pass", "saw": f"failed: {bad}"}] if bad else []
        time.sleep(60)
    return [{"check": "ci", "expected": "CI finishes", "saw": "timed out"}]


def parse_findings(text):
    """The reviewer's last {"findings": [...]} object, fenced as asked or bare (models drop the fence)."""
    blocks = re.findall(r"```json\s*(\{.*?\})\s*```", text, re.S)
    if blocks:
        return json.loads(blocks[-1])["findings"]
    decoder, found = json.JSONDecoder(), None
    for match in re.finditer(r'\{\s*"findings"', text):
        try:
            found = decoder.raw_decode(text, match.start())[0]["findings"]
        except (ValueError, KeyError):
            continue
    return found


def independent_review(node, wt, cfg):
    """A fresh session of the other agent, given only the issue and the diff.
    Returns None when no findings came back; REVIEW_UNAVAILABLE then says why, and the PR says so too."""
    global REVIEW_UNAVAILABLE
    REVIEW_UNAVAILABLE = None
    diff = sh(["git", "diff", "origin/main...HEAD"], cwd=wt).stdout
    prompt = f"{(OPS / 'prompts/review.md').read_text()}\n\n## Issue\n{node.body}\n\n## Diff\n{diff}"
    reviewer = "claude" if AGENTS[node.repo] == "opencode" else "opencode"
    branch = sh(["git", "branch", "--show-current"], cwd=wt).stdout.strip()
    # The review gets its own, shorter budget: the work is already built, pushed and green.
    review_cfg = {**cfg, "timeout_min": cfg.get("review_timeout_min", cfg["timeout_min"])}
    try:
        code, text = run_agent(reviewer, prompt, wt, review_cfg, read_only=True)
    except Stop as stop:
        if STOP_FILE.exists():
            raise
        code, text, REVIEW_UNAVAILABLE = 1, "", str(stop)
    findings = None if code else parse_findings(text)
    if findings is None:
        REVIEW_UNAVAILABLE = REVIEW_UNAVAILABLE or LAST_AGENT_ERROR or "the reply had no findings block"
        gh("pr", "comment", branch, "-R", REPOS[node.repo],
           "--body", f"Independent review unavailable ({reviewer}): {REVIEW_UNAVAILABLE}. The human verifies this PR.")
        return None
    lines = [f"- **{f.get('severity')}** `{f.get('file')}`: {f.get('summary')}" for f in findings]
    gh("pr", "comment", branch, "-R", REPOS[node.repo],
       "--body", f"Independent review ({reviewer})\n\n" + ("\n".join(lines) or "No findings."))
    return findings


def process(node, cfg):
    wt = prepare(node)
    state = load_state(node.id)
    handoff_file = handoff_path(node.id)
    set_status(node, "status:in-progress")
    note = state.get("feedback")
    while True:
        if state["attempts"] >= cfg["max_attempts"]:
            return escalate(node, "attempt budget spent", note or "")
        state["attempts"] += 1
        save_state(node.id, state)
        handoff_file.unlink(missing_ok=True)
        run_agent(node.agent, _brief.build(node, note), wt, cfg)
        if LAST_EGRESS_REFUSED:
            # A refusal is not a failure: the agent got an error and went on. It shows up in the retry's
            # DEAD ENDS, the posted handoff and ops/triage, where the human decides.
            new = [h for h in LAST_EGRESS_REFUSED if h not in state.setdefault("egress_refused", [])]
            state["egress_refused"] += new
            if new:
                state["dead_ends"].append(f"egress refused: {', '.join(new)} (not in ops/egress-allowlist)")
            save_state(node.id, state)
        text = handoff_file.read_text() if handoff_file.exists() else ""
        if not text and LAST_AGENT_ERROR:
            # Retrying cannot help while the API refuses every call.
            return escalate(node, f"the agent stopped: {LAST_AGENT_ERROR}")
        fields = parse_handoff(text)
        status = fields.get("STATUS", "").split(" ")[0]
        if status == "gap":
            post_handoff(node, text)
            if not add_gaps(node, fields.get("GAPS", "")):
                return escalate(node, "STATUS: gap without a valid gap issue id")
            set_status(node, "status:todo")
            return print(f"{node.id}: parked behind {fields.get('GAPS')}")
        if status == "needs_human":
            post_handoff(node, text)
            return escalate(node, fields.get("NEXT", "decision needed"))
        result = gate(node, wt, cfg, text)
        failures = result["failures"]
        review_note = ""
        if not failures:
            confirm(f"{node.id}: gate passed (tier {result['tier']}). Push and open a PR")
            branch = sh(["git", "branch", "--show-current"], cwd=wt).stdout.strip()
            sh(["git", "push", "-q", "-u", "origin", "HEAD"], cwd=wt)
            existing = sh(["gh", "pr", "view", branch, "-R", REPOS[node.repo], "--json", "number"], check=False)
            if existing.returncode:
                credit = "\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)" if node.agent == "claude" else ""
                gh("pr", "create", "-R", REPOS[node.repo], "--head", branch, "--title", node.title,
                   "--body", f"Closes #{node.number}\n\nTier {result['tier']}.\n\n{text}{credit}")
            set_status(node, "status:review")
            failures = wait_ci(node, branch, cfg)
        if not failures and result["tier"] >= 2:
            findings = independent_review(node, wt, cfg)
            if findings is None:
                # The PR is built, pushed and green; a stalled reviewer must not hold it back.
                findings = []
                review_note = f" Independent review unavailable ({REVIEW_UNAVAILABLE}); verify it yourself."
            high = [f for f in findings if f.get("severity") == "High"]
            failures = [{"check": "review", "expected": "no High findings", "saw": f"{f['file']}: {f['summary']}"} for f in high]
        if not failures:
            post_handoff(node, text)
            if result["tier"] in cfg["automerge"]:
                gh("pr", "merge", branch, "-R", REPOS[node.repo], "--merge", "--delete-branch")
                return print(f"{node.id}: merged")
            url = gh("pr", "view", branch, "-R", REPOS[node.repo], "--json", "url", "--jq", ".url").strip()
            escalate(node, f"Tier {result['tier']} PR is green and reviewed.{review_note} Merge when you agree: {url}")
            return print(f"\n>>> {node.id} is ready for you to merge: {url}\n{'   ' + review_note + chr(10) if review_note else ''}"
                         f"    After merging, ops/run --reconcile tidies labels and the worktree.\n")
        key = saw_key(failures)
        note = feedback(failures, node.block, state["dead_ends"])
        if key in state["saws"]:
            return escalate(node, "the same SAW came back twice", note)
        state["saws"].append(key)
        state["dead_ends"].append(fields.get("TRIED", "")[:300])
        state["feedback"] = note
        save_state(node.id, state)


def reconcile(nodes, repo=None):
    """Tidy up after merges: drop status labels from closed issues, remove merged worktrees.
    With a repo, touch only that repo, so parallel runners never race on the same item."""
    nodes = {k: n for k, n in nodes.items() if not repo or n.repo == repo}
    for node in nodes.values():
        stale = [l for l in node.labels if l.startswith("status:") or l == "needs:human"]
        if node.closed and stale:
            gh("issue", "edit", str(node.number), "-R", REPOS[node.repo],
               *[arg for label in stale for arg in ("--remove-label", label)])
            print(f"{node.id}: closed, removed {', '.join(stale)}")
    for wt in sorted((ROOT / "wt").glob("*-*")):
        repo, _, number = wt.name.partition("-")
        node = nodes.get(f"{repo}#{number}")
        if not node or not node.closed:
            continue
        checkout = ROOT / f"talent-scout-{repo}"
        sh(["git", "fetch", "-q", "origin"], cwd=checkout)
        branch = sh(["git", "branch", "--show-current"], cwd=wt).stdout.strip()
        dirty = sh(["git", "status", "--porcelain"], cwd=wt).stdout.strip()
        merged = not sh(["git", "merge-base", "--is-ancestor", "HEAD", "origin/main"], cwd=wt, check=False).returncode
        if dirty or not merged:
            print(f"{node.id}: closed, but {wt} is {'dirty' if dirty else 'not merged'}; left in place")
            continue
        sh(["git", "worktree", "remove", str(wt)], cwd=checkout)
        shutil.rmtree(container.clone_path(wt), ignore_errors=True)
        sh(["git", "branch", "-d", branch], cwd=checkout, check=False)
        state_path(node.id).unlink(missing_ok=True)
        handoff_path(node.id).unlink(missing_ok=True)
        print(f"{node.id}: removed {wt}")


def check_agent_auth():
    """Live probe of the agent token: it reads issues, and GitHub itself refuses its pushes."""
    ok = True
    with tempfile.TemporaryDirectory() as tmp:
        for repo in REPOS:
            checkout = ROOT / f"talent-scout-{repo}"
            env = agent_env(checkout, tmp)
            issues = subprocess.run(["gh", "issue", "list", "--limit", "1", "--json", "number"], cwd=checkout,
                                    env=env, capture_output=True, text=True)
            # --dry-run never writes; GitHub answers the receive-pack request with 403 before any ref moves.
            push = subprocess.run(["git", "push", "--dry-run", "origin", "HEAD:refs/heads/agent-token-probe"],
                                  cwd=checkout, env=env, capture_output=True, text=True)
            read_ok = issues.returncode == 0
            push_refused = push.returncode != 0 and "403" in push.stderr
            print(f"{repo}: read issues {'ok' if read_ok else 'FAILED'}; "
                  f"push {'refused by GitHub (403)' if push_refused else 'NOT refused with 403'}")
            if not read_ok:
                print("  " + issues.stderr.strip().replace("\n", "\n  "))
            if not push_refused:
                print("  " + push.stderr.strip().replace("\n", "\n  "))
            ok = ok and read_ok and push_refused
        status = subprocess.run(["gh", "auth", "status"], env=env, capture_output=True, text=True)
        print((status.stdout + status.stderr).strip())  # gh masks the token itself
    return 0 if ok else 1


def check_sandbox(repos=REPOS):
    """Prove the sandbox walls from inside each image (ADR 0002). PENDING walls arrive in later stages."""
    cfg = {**config(), "sandbox": "container"}
    ok = True
    for repo in repos:
        try:
            lines = container.probe(repo, cfg)
        except container.SandboxError as err:
            lines = [f"FAIL image: {err}"]
        print(f"{repo}:")
        for line in lines:
            print(f"  {line}")
        ok = ok and not any(line.startswith("FAIL") for line in lines)
    return 0 if ok else 1


def main():
    argv = sys.argv
    if "--check-agent-auth" in argv:
        sys.exit(check_agent_auth())
    if "--check-sandbox" in argv:
        sys.exit(check_sandbox())
    only = argv[argv.index("--node") + 1] if "--node" in argv else None
    repo = argv[argv.index("--repo") + 1] if "--repo" in argv else None
    cfg = config()
    if "--reconcile" in argv:
        return reconcile(load_nodes(ttl=0), repo)
    if container.mode(cfg) == "container":
        # Before the first node of a session, the walls must hold; otherwise nothing runs.
        if check_sandbox([repo] if repo else list(REPOS)):
            raise SystemExit("sandbox check failed; see above. Nothing ran.")
    while not STOP_FILE.exists():
        # Only the client runner owns the contract pin; exit 1 is drift, other codes are errors.
        if (repo or (only or "").split("#")[0]) != "server" and sh([str(OPS / "contract-sync"), "--check"], check=False).returncode == 1:
            confirm("The server contract moved. Open the client sync PR")
            sh([str(OPS / "contract-sync")])
        nodes = load_nodes(ttl=0)
        reconcile(nodes, repo)
        graph = analyze(nodes)
        ready = [k for k in graph["ready"] if nodes[k].agent in ("claude", "opencode")]
        ready = [k for k in ready if (k == only if only else (not repo or nodes[k].repo == repo))]
        if not ready:
            print("nothing ready")
            return
        node = nodes[ready[0]]
        try:
            confirm(f"Start {node.id}: {node.title}")
            process(node, cfg)
        except Stop as stop:
            post_handoff(node, f"STATUS: needs_human\nNEXT: resume with ops/run --node {node.id}\nKNOWN: {stop}")
            set_status(node, "status:todo")
            print(f"{node.id}: handed back: {stop}")
            return
        if "--once" in argv or only:
            return


if __name__ == "__main__":
    main()
