#!/usr/bin/env python3
"""Keep the client's pinned contract current. `--check` exits 1 when the server has moved."""
import hashlib
import json
import sys

sys.path.insert(0, __file__.rsplit("/", 1)[0])
from lib import REPOS, ROOT, config, gh, gh_env, push_argv, run_code, sh

FILES = {"docs/API.md": "docs/API.md", "docs/EVENTS.md": "docs/EVENTS.md", "docs/PRD.md": "docs/PRD.md",
         "api/openapi.yaml": "src/lib/server/api/openapi.yaml"}
SERVER = ROOT / "talent-scout-server"
CLIENT = ROOT / "talent-scout-client"


def digest(text):
    return hashlib.sha256(text.encode()).hexdigest()


def server_files(commit):
    return {path: sh(["git", "show", f"{commit}:{path}"], cwd=SERVER).stdout for path in FILES}


def main():
    sh(["git", "fetch", "-q", "origin"], cwd=SERVER)
    sh(["git", "fetch", "-q", "origin"], cwd=CLIENT)
    head = sh(["git", "rev-parse", "origin/main"], cwd=SERVER).stdout.strip()
    contents = server_files(head)
    hashes = {FILES[path]: digest(text) for path, text in contents.items()}
    current = sh(["git", "show", "origin/main:contract.lock"], cwd=CLIENT, check=False)
    locked = json.loads(current.stdout)["files"] if current.returncode == 0 else {}
    if locked == hashes:
        return 0
    branch = f"contract/{head[:8]}"
    # An open sync PR already carries this pin; it is waiting for the human merge, not drift to act on again.
    pending = gh("pr", "list", "-R", REPOS["client"], "--head", branch, "--state", "open",
                 "--json", "url", "-q", ".[0].url").strip()
    if pending:
        print(f"sync PR for {head[:8]} is waiting for merge: {pending}", file=sys.stderr)
        return 0
    if "--check" in sys.argv:
        return 1
    wt = ROOT / "wt" / f"client-contract-{head[:8]}"
    sh(["git", "worktree", "add", "-q", str(wt), "-b", branch, "--no-track", "origin/main"], cwd=CLIENT)
    for path, text in contents.items():
        (wt / FILES[path]).write_text(text)
    (wt / "contract.lock").write_text(json.dumps({"server_commit": head, "files": hashes}, indent=2) + "\n")
    # CI fails the PR when schema.d.ts lags openapi.yaml, so regenerate the types in the same commit.
    # Both run client repo code (lifecycle scripts, gen:api), so they run in the sandbox (ADR 0002).
    for command in ("pnpm install --frozen-lockfile", "pnpm gen:api"):
        done = run_code(command, str(wt), "client", config(), timeout=600)
        if done.returncode:
            raise RuntimeError(f"{command} in the sandbox: {done.stderr.strip()[-500:]}")
    sh(["git", "add", "-A"], cwd=wt)
    sh(["git", "commit", "-qm", f"chore: pin contract to server {head[:8]}"], cwd=wt)
    sh(push_argv(REPOS["client"], branch), cwd=wt, env=gh_env())
    gh("pr", "create", "-R", REPOS["client"], "--head", branch, "--title", f"chore: pin contract to server {head[:8]}",
       "--body", f"Byte-identical copy of the contract at {REPOS['server']}@{head}. Approval happened on the server.")
    sh(["git", "worktree", "remove", "--force", str(wt)], cwd=CLIENT)
    print(f"opened sync PR for {head[:8]}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as error:  # exit 1 means drift; anything else must not look like drift
        print(f"contract-sync failed: {error}", file=sys.stderr)
        sys.exit(2)
